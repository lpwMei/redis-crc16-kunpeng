+# CRC16 acceleration (aarch64 only). The object is compiled with the crypto
+# extension enabled; runtime selection happens in crc16.c via getauxval, so
+# the resulting binary still runs on aarch64 CPUs without PMULL.
+UNAME_M := $(shell uname -m)
+ifeq ($(UNAME_M),aarch64)
+REDIS_CRC16_ACCEL = crc16_aarch64.o
+CRC16_ACCEL_CFLAGS = -march=armv8-a+crypto
+else
+REDIS_CRC16_ACCEL =
+CRC16_ACCEL_CFLAGS =
+endif
